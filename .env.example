# Environment
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=loto_user
DB_PASSWORD=loto_password
DB_DATABASE=loto_db
DB_ROOT_PASSWORD=root_password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Backend
BACKEND_PORT=3000

# Frontend
FRONTEND_PORT=4200

# Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=./uploads
