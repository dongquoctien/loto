# ============================================================
# Loto Production Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# Database
MYSQL_ROOT_PASSWORD=change_this_to_strong_password
MYSQL_PASSWORD=change_this_to_strong_password

# JWT Secret (min 32 characters)
JWT_SECRET=change_this_to_very_long_random_string_min_32_chars

# Domain
DOMAIN=loto.dongquoctien.online

# Email for SSL certificate
SSL_EMAIL=your-email@example.com
