{
  "name": "loto",
  "version": "1.0.0",
  "description": "Game Lo To Online Vietnam",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "cd packages/shared && npm run build",
    "build:backend": "cd apps/backend && npm run build",
    "build:frontend": "cd apps/frontend && npm run build",
    "dev:backend": "cd apps/backend && npm run start:dev",
    "dev:frontend": "cd apps/frontend && npm start",
    "start:backend": "cd apps/backend && npm run start:prod",
    "start:frontend": "cd apps/frontend && npm start",
    "seed": "cd apps/backend && npx ts-node src/database/seeds/ticket-seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
